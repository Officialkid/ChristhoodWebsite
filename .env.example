# Admin area and live content (Sanity). Leave empty to run on the content that ships with the site.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only needed to run `npm run seed` once. Create it in the Sanity project settings (Editor access). Never commit it.
SANITY_WRITE_TOKEN=

# Public address of the live site, used for sharing previews and the sitemap.
NEXT_PUBLIC_SITE_URL=https://christhood-website.vercel.app
