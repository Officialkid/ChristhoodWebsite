# Public address of the live site. Used for sharing links, QR codes and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.christhoodministries.org

# ---- Team area (/123admin). All of these are set once in the hosting dashboard. ----

# A long random value (32+ characters). Signs people in. Required on the live site.
AUTH_SECRET=

# Any secret phrase. Typed once when the first administrator is created on the live site.
ADMIN_SETUP_KEY=

# Saving changes. Connect ONE database. If several are set, MongoDB wins, then Redis, then Postgres.
#  - MongoDB (Atlas or any MongoDB 5+): the connection string below. Add MONGODB_DB only if the string names no database (default: christhood).
#  - Neon Postgres: DATABASE_URL (or POSTGRES_URL)
#  - Upstash Redis: the two values below
# (Vercel may name them KV_REST_API_URL and KV_REST_API_TOKEN instead. Both work.)
MONGODB_URI=
MONGODB_DB=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encrypts children's health details in camp applications. 32+ random characters. KEEP A COPY: without it they cannot be read.
REGISTRATION_KEY=

# Optional: a file host for a very large photo library (Vercel Blob adds this for you).
BLOB_READ_WRITE_TOKEN=

# Optional: let the Media Team search Immich and copy selected photos to Cloudinary for website delivery.
# The Immich server must be reachable by the deployed site over HTTPS. Use an Immich API key
# with asset read, view and download access. Keep Cloudinary credentials server-side.
# Never expose CLOUDINARY_API_SECRET to browser code.
IMMICH_SERVER_URL=
IMMICH_API_KEY=
# Public Immich web address shown inside the Media section (defaults to IMMICH_SERVER_URL).
IMMICH_WEB_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload folder in Cloudinary. Defaults to christhood/media.
CLOUDINARY_ASSET_FOLDER=christhood/media
# Cloudinary folders created since June 2024 use dynamic mode. Set fixed only for a legacy environment.
CLOUDINARY_FOLDER_MODE=dynamic

# Optional: a short email (no details) when a new guest or prayer request arrives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAILS=
# Optional: transactional text messages via https://httpsms.com. The phone with HTTPSMS_FROM
# must have the httpSMS Android app installed and signed in with HTTPSMS_API_KEY.
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# Optional camp office recipients for a short new-application alert. Comma-separated E.164 numbers.
CAMP_SMS_TO=
# Optional: the dedicated Protocol inbox for public questions and welcome-email replies.
PROTOCOL_EMAIL=

# Optional: also copy new guests and prayer requests into the church's private Google Sheet.
# Deploy integrations/google-sheet/Code.gs as a web app and paste its /exec address here.
GOOGLE_SHEET_WEBHOOK=
