# Public address of the live site. Used for sharing links, QR codes and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.christhoodministries.org

# ---- Team area (/123admin). All of these are set once in the hosting dashboard. ----

# A long random value (32+ characters). Signs people in. Required on the live site.
AUTH_SECRET=

# Any secret phrase. Typed once when the first administrator is created on the live site.
ADMIN_SETUP_KEY=

# Saving changes: a free Upstash Redis database from the Vercel Marketplace adds these for you.
# (Vercel may name them KV_REST_API_URL and KV_REST_API_TOKEN instead. Both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a file host for a very large photo library (Vercel Blob adds this for you).
BLOB_READ_WRITE_TOKEN=

# Optional: a short email (no details) when a new guest or prayer request arrives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAILS=

# Optional: also copy new guests and prayer requests into the church's private Google Sheet.
# Deploy integrations/google-sheet/Code.gs as a web app and paste its /exec address here.
GOOGLE_SHEET_WEBHOOK=
